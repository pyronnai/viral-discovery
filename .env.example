# ─────────────────────────────────────────────────────────────
# viral-discovery — environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# Loaded by the worker/CLI via Node's --env-file-if-exists.
# ─────────────────────────────────────────────────────────────

# Runtime. NODE_ENV: development | test | production
NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL (required)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/viral_discovery
DATABASE_POOL_MAX=10

# pg-boss job queue: lives in the same database, in its own schema
PGBOSS_SCHEMA=pgboss

# Worker graceful-shutdown timeout
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# Source credentials — NOT used in Phase 1.
# Listed so future adapters have a documented home.
# Leave unset until the adapter exists and access is approved.
# ─────────────────────────────────────────────────────────────
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Reddit requires: <platform>:<app ID>:<version string> (by /u/<reddit username>)
# REDDIT_USER_AGENT=
