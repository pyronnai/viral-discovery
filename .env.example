# ─────────────────────────────────────────────────────────────
# viral-discovery — environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# Loaded by the worker/CLI via Node's --env-file-if-exists.
# ─────────────────────────────────────────────────────────────

# Runtime. NODE_ENV: development | test | production
NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL (required)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/viral_discovery
DATABASE_POOL_MAX=10

# pg-boss job queue: lives in the same database, in its own schema
PGBOSS_SCHEMA=pgboss

# Worker graceful-shutdown timeout
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# Source adapters. All optional: an adapter is enabled only when
# its own variables are set (see `pnpm cli adapters`).
# Values are secrets — never commit them, never paste them in logs.
# ─────────────────────────────────────────────────────────────
# YouTube Data API v3 key (public data only). docs/sources/youtube.md
# YOUTUBE_API_KEY=
# Application batch size for videos:batchGetStats (YouTube documents no maximum). Default 50.
# YOUTUBE_STATS_BATCH_SIZE=50
# Twitch app (client-credentials flow). docs/sources/twitch.md
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# Bluesky needs no credentials. Unauthenticated AppView host (default below).
# BLUESKY_APPVIEW_URL=https://api.bsky.app
# TikTok (manual URLs via oEmbed) needs no credentials.

# Reddit — NOT implemented: API access requires Reddit approval, and commercial
# use requires explicit written approval. docs/sources/reddit.md
# Reddit requires: <platform>:<app ID>:<version string> (by /u/<reddit username>)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
